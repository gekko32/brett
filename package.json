{
  "name": "workspace-brett",
  "engines": {
    "node": ">=22.13.0"
  },
  "version": "0.46.1",
  "private": true,
  "main": "src/server/index.ts",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "MOCK_DB=true tsx --test test/*.test.ts test/*.test.js test/*.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "jspdf": "^4.2.1",
    "multer": "^2.4.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jspdf": "^2.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "esbuild": "^0.28.1",
    "nanoid@<3.3.18": "3.3.18",
    "dompurify@<3.4.16": "3.4.16",
    "qs@<6.16.0": "6.16.0"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true
  }
}
